#!/usr/bin/env bash

source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="JetBrainsMono Nerd Font Mono"

bar=(
  position=top
  height=34
  margin=6
  corner_radius=9
  border_width=0
  color="$TRANSPARENT"
  blur_radius=0
  padding_left=14
  padding_right=8
  notch_width=220
  display=all
  topmost=window
  sticky=on
  shadow=off
)
sketchybar --bar "${bar[@]}"

defaults=(
  updates=when_shown
  icon.font="$FONT:Semibold:16.0"
  icon.color="$TEXT_COLOR"
  icon.padding_left=6
  icon.padding_right=6
  label.font="$FONT:Medium:16.0"
  label.color="$TEXT_COLOR"
  label.padding_left=6
  label.padding_right=6
  background.color="$SURFACE_COLOR"
  background.border_color="$BORDER_COLOR"
  background.border_width=1
  background.corner_radius=7
  background.height=24
  popup.background.color="$BAR_COLOR"
  popup.background.border_color="$BORDER_COLOR"
  popup.background.border_width=1
  popup.background.corner_radius=8
)
sketchybar --default "${defaults[@]}"

sketchybar --add event aerospace_workspace_change

sketchybar --add item apple left \
  --set apple \
  icon="" \
  icon.font="$FONT:Regular:20.0" \
  icon.color="$TEXT_COLOR" \
  icon.padding_left=5 \
  icon.padding_right=5 \
  label.drawing=off \
  background.drawing=off \
  padding_right=8

for workspace in {1..10}; do
  sketchybar --add item "workspace.$workspace" left \
    --set "workspace.$workspace" \
    icon="$workspace" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    padding_left=3 \
    padding_right=3 \
    background.corner_radius=5 \
    background.height=26 \
    label.drawing=off \
    click_script="aerospace workspace $workspace" \
    script="$PLUGIN_DIR/aerospace.sh $workspace" \
    --subscribe "workspace.$workspace" \
    aerospace_workspace_change \
    front_app_switched \
    space_windows_change
done

sketchybar --add item front_app left \
  --set front_app \
  icon.drawing=off \
  label.max_chars=28 \
  background.drawing=off \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock \
  icon.drawing=off \
  background.drawing=off \
  padding_left=5 \
  padding_right=5 \
  update_freq=10 \
  click_script="open -a Calendar" \
  script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --set battery \
  icon.padding_right=2 \
  label.padding_left=2 \
  background.drawing=off \
  padding_left=5 \
  padding_right=5 \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

# Wi-Fi / Personal Hotspot and Ivanti VPN state. Scripted indicators avoid
# SketchyBar aliases, which macOS Tahoe breaks for third-party status items,
# and need no Screen Recording permission.
sketchybar --add item vpn right \
  --set vpn \
  background.drawing=off \
  padding_left=5 \
  padding_right=5 \
  update_freq=15 \
  script="$PLUGIN_DIR/vpn.sh"

sketchybar --add item wifi right \
  --set wifi \
  background.drawing=off \
  padding_left=5 \
  padding_right=5 \
  update_freq=15 \
  click_script='open "x-apple.systempreferences:com.apple.wifi-settings-extension"' \
  script="$PLUGIN_DIR/wifi.sh" \
  --subscribe wifi system_woke

sketchybar --update
