
# Do not force new Ghostty windows to open maximized/fullscreen.
# AeroSpace should control window size/tiling.
# fullscreen = true
# macos-non-native-fullscreen = visible-menu
# maximize = true

# making things bigger
font-size = 18
# setting fontface for terminal
font-family = "JetBrainsMono Nerd Font Mono"

# Classic Gruvbox Dark Hard, matching the rest of the terminal UI.
theme = "Gruvbox Dark Hard"

# Give tiled windows breathing room without taking too much space.
window-padding-x = 12
window-padding-y = 12

# Keep the preferred translucent background.
background-opacity = 0.9
background-blur-radius = 20

# Explicit focus and selection colors from the tracked Gruvbox palette.
cursor-color = #fabd2f
cursor-text = #1d2021
selection-background = #3c3836
selection-foreground = #fbf1c7

# animate cursor movement with a short, fading Neovide-style warp
custom-shader = shaders/cursor_warp.glsl

# cosmetic: nicer icon on macos
macos-icon = "blueprint"
# cosmetic: hiding mouse when editing
mouse-hide-while-typing = true
