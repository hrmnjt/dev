# Template copied automatically to ~/.config/llama/server.env by llm-switch.
# The resulting host-local file is sourced as trusted POSIX shell configuration.

LOCAL_LLM_MODEL=""
LOCAL_LLM_MODELS_DIR="$HOME/code/github.com/hrmnjt/dev/_models"
LOCAL_LLM_ALIAS="local-model"

# Keep this value in sync with contextWindow in ~/.pi/agent/models.json.
LOCAL_LLM_CONTEXT_SIZE=32768
LOCAL_LLM_HOST="127.0.0.1"
LOCAL_LLM_PORT=8080
LOCAL_LLM_PARALLEL=1
LOCAL_LLM_START_TIMEOUT=300

# Optional overrides:
# LOCAL_LLM_BINARY="/opt/homebrew/bin/llama-server"
# LOCAL_LLM_MMPROJ="$HOME/path/to/mmproj.gguf"
