{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#d8dee9",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "\u2502 ",
    "color": "#d8dee9"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#88c0d0",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#2e3440",
    "background_color": "#88c0d0",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#88c0d0",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#8fbcbb",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#81a1c1",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#5e81ac",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "color": "#b48ead",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#4c566a",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "\u2022 ",
    "color": "#d8dee9"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#d8dee9"
  },
  "task": {
    "ticked": "[\u2713] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#88c0d0",
    "underline": true
  },
  "link_text": {
    "color": "#8fbcbb",
    "bold": true
  },
  "image": {
    "color": "#b48ead",
    "underline": true
  },
  "image_text": {
    "color": "#616e88",
    "format": "Image: {{.text}} \u2192"
  },
  "code": {
    "prefix": "\u00a0",
    "suffix": "\u00a0",
    "color": "#d08770",
    "background_color": "#3b4252"
  },
  "code_block": {
    "color": "#e5e9f0",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#d8dee9"
      },
      "error": {
        "color": "#eceff4",
        "background_color": "#bf616a"
      },
      "comment": {
        "color": "#616e88",
        "italic": true
      },
      "comment_preproc": {
        "color": "#d08770"
      },
      "keyword": {
        "color": "#81a1c1"
      },
      "keyword_reserved": {
        "color": "#81a1c1"
      },
      "keyword_namespace": {
        "color": "#81a1c1"
      },
      "keyword_type": {
        "color": "#8fbcbb"
      },
      "operator": {
        "color": "#81a1c1"
      },
      "punctuation": {
        "color": "#eceff4"
      },
      "name": {
        "color": "#d8dee9"
      },
      "name_builtin": {
        "color": "#81a1c1"
      },
      "name_function": {
        "color": "#88c0d0"
      },
      "name_class": {
        "color": "#8fbcbb"
      },
      "name_namespace": {
        "color": "#8fbcbb"
      },
      "name_variable": {
        "color": "#d8dee9"
      },
      "name_variable_global": {
        "color": "#d8dee9"
      },
      "name_variable_magic": {
        "color": "#b48ead"
      },
      "name_attribute": {
        "color": "#8fbcbb"
      },
      "name_tag": {
        "color": "#81a1c1"
      },
      "literal_number": {
        "color": "#b48ead"
      },
      "literal_string": {
        "color": "#a3be8c"
      },
      "literal_string_escape": {
        "color": "#ebcb8b"
      },
      "generic_deleted": {
        "color": "#bf616a"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#a3be8c"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#88c0d0"
      },
      "background": {
        "background_color": "#2e3440"
      }
    },
    "background_color": "#2e3440"
  },
  "table": {
    "center_separator": "\u253c",
    "column_separator": "\u2502",
    "row_separator": "\u2500"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n\ud83e\udc36 "
  },
  "html_block": {},
  "html_span": {}
}
